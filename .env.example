#==== Server ====
# Port this server listens on
PORT=3000
# Public base URL (e.g. https://xxxx.trycloudflare.com from cloudflared).
# Used to build the NCCO WebSocket URI. If empty, derived from the request Host header.
# cloudflared URLs change on every restart, so setting this explicitly is recommended.
PUBLIC_URL=
# Trust X-Forwarded-* headers for the real client IP (login rate limiting) and send
# Secure cookies. Derived automatically from https PUBLIC_URL / VONAGE_ANSWER_URL /
# VONAGE_EVENT_URL (true). Override explicitly for other proxies, e.g. TRUST_PROXY=loopback.
TRUST_PROXY=
# Trust proxy headers (X-Forwarded-For etc). Accepted values: true/false or an
# Express-style string like "loopback". If unset, defaults to true only when a
# public HTTPS URL (PUBLIC_URL / VONAGE_ANSWER_URL / VONAGE_EVENT_URL) is set,
# i.e. you are expected to be behind a TLS-terminating proxy (cloudflared).
# Keep this false when nothing terminates TLS, otherwise clients can spoof the
# login rate-limiter's client IP.
TRUST_PROXY=

#==== ElevenLabs ====
# API key (ElevenLabs dashboard -> Profile / API Keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Agent ID (Conversational AI -> Agents -> ... menu -> Copy Agent ID)
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id
# Optional: override the agent's voice. Leave empty to use the agent's default voice.
ELEVENLABS_VOICE_ID=
# Optional: override prompt / first message / language.
# AGENT_LANGUAGE: leave empty to follow the admin UI language (ja/en) at call time.
AGENT_PROMPT=
AGENT_FIRST_MESSAGE=
AGENT_LANGUAGE=

#==== Vonage ====
# Application ID (Vonage Dashboard -> Applications)
VONAGE_APPLICATION_ID=
# LVN (Local Virtual Number) linked to this application (E.164, e.g. 819012345678).
# Shown in the admin UI and checked against the inbound call's "to" number.
VONAGE_LVN=
# Path to the application's private.key (downloaded when the application was created).
# Relative paths are resolved from the project root. Used for JWT auth to the Vonage API.
VONAGE_PRIVATE_KEY_PATH=./private.key
# API key/secret - alternative (Basic) auth for the Vonage API. Optional if the private key is set.
# Normally you leave these unset and use VONAGE_PRIVATE_KEY_PATH (JWT) instead.
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# Public webhook URLs of THIS server (must be reachable by Vonage, e.g. cloudflared URL).
# When all of the above are set, the server applies these to the application
# (answer_url GET / event_url POST) via the Applications API at startup.
# They are also used as the base URL for the NCCO WebSocket URI (overrides PUBLIC_URL).
VONAGE_ANSWER_URL=
VONAGE_EVENT_URL=
# Spoken greeting played by Vonage (talk) before the WebSocket connects.
# Which text/language is used follows the admin UI language (ja/en).
GREETING_TEXT_JA=お電話ありがとうございます。ただいま接続いたします。
GREETING_TEXT_EN=Thank you for calling. Connecting you now.
# Force the talk voice language regardless of UI language (e.g. ja-JP / en-US). Empty = follow.
GREETING_LANGUAGE=

#==== Admin UI ====
# Admin UI language: ja (default) or en. Users can switch in the UI; the choice is
# remembered in the browser and overrides this default.
UI_LANGUAGE=ja
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Long random string used to sign session cookies
SESSION_SECRET=please-change-this-session-secret

#==== Optional ====
# Record raw audio of both directions to ./recordings (PCM files)
RECORD_ALL_AUDIO=false
